# URL publicável da aplicação; não é uma credencial.
# Na Vercel: definir a origem HTTPS exata separadamente em Preview e Production.
# Configuração e callbacks: docs/PUBLICACAO.md. Nunca reutilizar banco real em PR arbitrário.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Deixe integrações não utilizadas em branco. Não coloque segredos em NEXT_PUBLIC_*.
# Supabase Auth / banco: URL https do projeto e chave publicável.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Cadastro público exige true aqui E cadastro habilitado no Supabase. Padrão: convites.
AUTH_ALLOW_SIGNUP=false
# Opcional, exclusivamente para envio administrativo de convite Auth. Nunca NEXT_PUBLIC_*.
SUPABASE_SECRET_KEY=

# Google Places API (New): credencial exclusiva do servidor.
GOOGLE_PLACES_API_KEY=

# Maps: chave publicável restrita por domínio e API; Map ID do projeto.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# PageSpeed Insights: credencial exclusiva do servidor.
GOOGLE_PAGESPEED_API_KEY=
# Executor de auditorias: segredo aleatório de 32 bytes em hexadecimal (64 caracteres).
# Somente servidor; cadastrar apenas seu SHA-256 no schema private conforme docs/AUDITORIAS.md.
AUDIT_EXECUTOR_SECRET=

# OpenAI: credencial exclusiva do servidor e identificador do modelo autorizado.
OPENAI_API_KEY=
OPENAI_MODEL=
# Prova do backend para consumo de IA: segredo aleatório de 32 bytes em hexadecimal.
# Cadastrar apenas o SHA-256 em private.message_executor_config; docs/MENSAGENS-IA.md.
MESSAGE_EXECUTOR_SECRET=
# CRM: prova do backend para operações com referências aprovadas e metadados comerciais.
# 32 bytes aleatórios em hexadecimal; SHA-256 em private.crm_executor_config. docs/CRM.md.
CRM_EXECUTOR_SECRET=

# Capacidades: todas fechadas. Flags não concedem licença nem configuram a fonte.
# Google Places/Maps permanecem bloqueados pela política do produto mesmo com true/chaves válidas.
FEATURE_CATALOG_SEARCH=false
# Catálogo privado previamente aprovado por operador; não colocar em public ou Git.
# Ex.: .local-data/fonte-ag.catalog.local.json; não usar fixtures de teste em produção.
OWNED_CATALOG_FILE=
# Alternativa gratuita nacional: IBGE + OSM/Private.coffee + OpenFreeMap.
# Não usa chaves Google. Exige migração 011 e CRM_EXECUTOR_SECRET/hash existentes.
# IDs administrativos configurados somente pelo operador; nunca recebidos da interface.
OPEN_DATA_CATALOG_ENABLED=false
OPEN_DATA_WORKSPACE_ID=
OPEN_DATA_REVIEWER_ID=
FEATURE_CATALOG_DETAILS=false
FEATURE_GOOGLE_PLACES=false
FEATURE_GOOGLE_MAPS=false
FEATURE_WEBSITE_AUDIT=false
FEATURE_AI_MESSAGES=false
FEATURE_OWN_DATA_PERSISTENCE=false
FEATURE_DATA_EXPORT=false

# Executores de auditorias/IA exigem configuração explícita; sem execução após a resposta.
